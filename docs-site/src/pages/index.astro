---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";

const cards = [
  {
    href: "/getting-started/install",
    title: "Install",
    body: "Packages for macOS, Windows, and Linux — and the one-time first-launch fix.",
  },
  {
    href: "/getting-started/first-run",
    title: "First run",
    body: "Open a repo, read the graph, make your first commit.",
  },
  {
    href: "/guides",
    title: "Guides",
    body: "Branch operations, staging, conflicts, pull requests, identities.",
  },
  {
    href: "/reference/architecture",
    title: "Architecture",
    body: "Rust core, React frontend, and the read/write split.",
  },
  {
    href: "/reference/troubleshooting",
    title: "Troubleshooting",
    body: "The problems people actually hit, and what to do.",
  },
  {
    href: "https://github.com/Siomkin/GitLane/releases",
    title: "Releases",
    body: "Download the latest build from GitHub.",
    external: true,
  },
];
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-3xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        Git, in lanes you can read.
      </h1>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed">
        GitLane is a fast, lightweight visual git client for macOS, Windows, and
        Linux — a free, open-source alternative to GitKraken, Sourcetree, and
        Fork.
      </p>

      <img
        src="/screenshots/hero-graph.png"
        alt="The GitLane swimlane commit graph"
        class="mt-10 rounded-lg border border-border"
        loading="eager"
      />

      <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          cards.map((card) => (
            <a
              href={card.href}
              target={card.external ? "_blank" : undefined}
              rel={card.external ? "noopener" : undefined}
              class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
            >
              <div class="font-medium text-foreground">{card.title}</div>
              <div class="mt-0.5 text-sm text-muted-foreground">{card.body}</div>
            </a>
          ))
        }
      </div>
    </main>
  </div>
</BaseLayout>
